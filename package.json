{
  "name": "guardian-watch",
  "version": "1.0.0",
  "description": "GuardianWatch helps parents monitor online predator contact and preserve evidence for reporting.",
  "main": "src/main.js",
  "homepage": "./",
  "author": "GuardianWatch Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --development",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "pack": "electron-builder --dir",
    "test": "jest",
    "lint": "eslint src/",
    "release": "standard-version"
  },
  "keywords": [
    "safety",
    "parental-control",
    "monitoring",
    "evidence",
    "predator"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.0.3",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "standard-version": "^9.5.0"
  },
  "build": {
    "appId": "com.polsia.guardianwatch",
    "productName": "GuardianWatch",
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GuardianWatch"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
